# Copy this file to .env. Never commit real API keys.

# Language model
# Use groq for hosted inference or ollama for local inference.
LLM_PROVIDER=groq

# Groq
LLM_MODEL=qwen/qwen3.6-27b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Keep temperature at zero for grounded answers.
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=240
LLM_DISABLE_THINKING=true

# Embeddings
# Rebuild the index after changing the embedding model.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# Chunking
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_DENSE_CANDIDATES=12
RETRIEVAL_LEXICAL_CANDIDATES=12
RETRIEVAL_MIN_SIMILARITY=0.75
REVISION_SWEEP_DELTA=0.06
REVISION_SWEEP_MAX=3
VALUE_SWEEP_DELTA=0.08
VALUE_SWEEP_MAX=3
# Add an English search form for Arabic questions.
CROSS_LINGUAL_EXPANSION=true

# Behavior
ENABLE_QUERY_REWRITE=true
MAX_HISTORY_TURNS=6
ENFORCE_CITATION_VALIDATION=true

# Development
# Keep false in public deployments.
DEBUG_RETRIEVAL=false

# Paths
# PROJECT_ROOT=.
# DATA_DIR=./data/approved
# INDEX_DIR=./artifacts/index

# UI
APP_TITLE=Mamlaka AI — مساعد المملكة الذكي
